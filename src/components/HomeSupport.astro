---
import { ArrowRight, CreditCard, SprayCan, Truck } from '@lucide/astro';
import WhatsAppSupport from './WhatsAppSupport.astro';

const questions = [
  {
    id: 'perfumes', topic: 'Perfumes', icon: SprayCan,
    title: '¿Cómo elijo un perfume?',
    answer: 'Filtra por clima y ocasión. En la ficha de cada perfume puedes consultar sus notas y saber cuándo usarlo.',
    link: { href: '/perfumes', label: 'Ver perfumes' },
  },
  {
    id: 'pagos', topic: 'Pagos', icon: CreditCard,
    title: '¿Cómo pago mi pedido?',
    answer: 'Paga con Yape o Plin y adjunta tu comprobante. Cuando confirmemos el pago, empezaremos a preparar tu pedido.',
  },
  {
    id: 'recojo', topic: 'Recojo', icon: Truck,
    title: '¿Dónde recojo mi pedido?',
    answer: 'Elige una agencia al finalizar la compra. Pagas el flete al transportista cuando recoges tu pedido.',
    link: { href: '/envios', label: 'Cómo funcionan los envíos' },
  },
];
---
<section class="container home-support" id="ayuda" aria-labelledby="home-support-title">
  <div class="support-petals" data-home-help>
    <h2 id="home-support-title">¿Cómo podemos ayudarte?</h2>
    <div class="support-topics" role="group" aria-label="Temas de ayuda" hidden>
      {questions.map(({ id, topic, icon: Icon }) => (
        <button type="button" aria-expanded="false" aria-controls={`ayuda-${id}`}>
          <Icon size={20} stroke-width={1.7} aria-hidden="true" />
          {topic}
        </button>
      ))}
    </div>
    <div class="support-answers">
      {questions.map(({ id, title, answer, link }) => (
        <div class="support-answer" id={`ayuda-${id}`} aria-labelledby={`pregunta-${id}`}>
          <h3 id={`pregunta-${id}`}>{title}</h3>
          <p>{answer}</p>
          {link && <a href={link.href}>{link.label} <ArrowRight size={16} aria-hidden="true" /></a>}
        </div>
      ))}
    </div>
    <WhatsAppSupport label="Contáctanos" />
  </div>
</section>

<style>
  .home-support { padding-block: clamp(18px, 3vw, 42px) clamp(34px, 5vw, 64px); scroll-margin-top: 110px; }
  .support-petals {
    display: grid;
    justify-items: center;
    padding: clamp(23px, 5.2vw, 62px) clamp(16px, 5.2vw, 62px);
    border-radius: 18px;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink);
    text-align: center;
  }
  h2, h3 { margin: 0; font-family: var(--serif); font-weight: 500; line-height: 1.08; letter-spacing: -.037em; text-wrap: balance; }
  h2 { font-size: clamp(2rem, 4.2vw, 4rem); }
  h3 { font-size: clamp(1.5rem, 2.6vw, 2.3rem); }
  .support-topics {
    position: relative;
    isolation: isolate;
    display: flex;
    justify-content: center;
    gap: 9px;
    width: 100%;
    margin-top: clamp(19px, 2.1vw, 26px);
  }
  .support-topics::before {
    content: '';
    position: absolute;
    inset: 50% 11% auto;
    z-index: -1;
    border-top: 1px solid #c9aedb;
  }
  .support-topics button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 53px;
    padding: 8px 16px;
    border: 1px solid #d0b7de;
    border-radius: 999px;
    background: #fdf8ff;
    color: #472362;
    font-weight: 700;
    transition: background-color .22s, color .22s, border-color .22s;
  }
  .support-topics button:hover { background: #e7d6f1; }
  .support-topics button[aria-expanded="true"] { border-color: #573187; background: #573187; color: #fff; }
  .support-answers { width: 100%; display: grid; justify-items: center; gap: 22px; margin-block: 25px 15px; }
  .support-answer { display: grid; justify-items: center; align-content: start; gap: 8px; width: 100%; }
  [data-interactive] .support-answers { min-height: 137px; }
  [data-interactive] .support-answer { grid-area: 1 / 1; }
  [data-interactive] .support-answer:not([data-current]) { visibility: hidden; }
  .support-answer p { max-width: 46ch; margin: 0; color: #483651; }
  .support-answer a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 44px;
    color: var(--purple-deep);
    font-size: .93rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: .2em;
  }
  .support-petals :global(.whatsapp-support) { min-height: 45px; padding-inline: 15px; }
  @media (max-width: 665px) {
    .support-topics { gap: 6px; max-width: 370px; }
    .support-topics button { flex: 1; flex-direction: column; gap: 3px; min-height: 62px; padding: 6px; font-size: .82rem; }
    [data-interactive] .support-answers { min-height: 157px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-interactive] .support-answer[data-current] { animation: petal-reveal .38s cubic-bezier(.16,1,.3,1) both; }
    @keyframes petal-reveal {
      from { clip-path: inset(0 0 100%); opacity: .5; transform: translateY(-7px); }
      to { clip-path: inset(0); }
    }
  }
  @media (prefers-reduced-motion: reduce) { .support-topics button { transition: none; } }
</style>
<script>
  const help = document.querySelector<HTMLElement>('[data-home-help]');
  if (help) {
    const topics = help.querySelector<HTMLElement>('.support-topics')!;
    const buttons = [...topics.querySelectorAll('button')];
    const answers = [...help.querySelectorAll<HTMLElement>('.support-answer')];

    function show(index: number) {
      buttons.forEach((button, position) => {
        button.setAttribute('aria-expanded', String(position === index));
        answers[position].toggleAttribute('data-current', position === index);
        answers[position].inert = position !== index;
      });
    }

    show(0);
    topics.hidden = false;
    help.setAttribute('data-interactive', '');
    buttons.forEach((button, index) => {
      button.addEventListener('click', () => show(button.getAttribute('aria-expanded') === 'true' ? -1 : index));
    });
  }
</script>

---
interface Props { placement: string; }
const { placement } = Astro.props;
const letters = `brand-letters-${placement}`;
const clip = `brand-us-${placement}`;
---
<a href="/" class:list={['wordmark', placement === 'footer' && 'footer-wordmark']} aria-label="FraganUS, inicio">
  <svg class="brand-symbol" viewBox="0 0 32 32" aria-hidden="true">
    <use href="/brand/icon.svg#mark" />
  </svg>
  <span class="brand-name" aria-hidden="true">Fragan</span>
  <svg class="brand-us" viewBox="0 0 35 24" aria-hidden="true">
    <defs>
      <path id={letters} d="M.6 2h4.1v11.6c0 3.25 1.33 4.85 4 4.85 2.65 0 4-1.6 4-4.85V2h4.08v11.75c0 5.4-3.02 8.45-8.1 8.45-5.05 0-8.08-3.05-8.08-8.45V2Zm17.48 17.18 2.33-2.98c1.92 1.62 3.6 2.33 5.92 2.33 2.13 0 3.55-.78 3.55-2.12 0-1.27-.82-1.93-4.2-2.7-4.35-1.01-6.86-2.47-6.86-6.03 0-3.52 2.86-5.94 7.16-5.94 3 0 5.47.91 7.44 2.59l-2.18 3.18a8.9 8.9 0 0 0-5.35-2.11c-1.96 0-2.99.77-2.99 1.91 0 1.36 1.04 1.91 4.56 2.75 4.18 1 6.52 2.58 6.52 6.01 0 3.87-3 6.18-7.74 6.18-3.5 0-6.14-1.21-8.16-3.07Z" />
      <clipPath id={clip}><use href={`#${letters}`} /></clipPath>
    </defs>
    <g clip-path={`url(#${clip})`}>
      <path fill="#fff5f3" d="M0 2h35v21H0z" />
      <path stroke="#ac203b" stroke-width="1.6" d="M0 2.8h35M0 6h35M0 9.2h35M0 12.4h35M0 15.6h35M0 18.8h35M0 22h35" />
      <path fill="#233762" d="M0 2h16.8v11.2H0z" />
      {[2.55, 6.1, 9.65, 13.2].flatMap((x) => [4.6, 7.8, 11].map(y =>
        <path fill="#fff" transform={`translate(${x} ${y})`} d="m0-.89.22.59.64.03-.51.39.18.62L0 .38l-.53.36.18-.62-.51-.39.64-.03Z" />
      ))}
    </g>
    <use href={`#${letters}`} fill="none" stroke="var(--brand-flag-outline, #594251)" stroke-width=".6" />
  </svg>
</a>

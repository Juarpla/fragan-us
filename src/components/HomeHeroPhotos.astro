---
import { ChevronLeft, ChevronRight, Pause, Play } from '@lucide/astro';

const photos = [
  { src: '/brand/hero-perfumes.webp', alt: 'Odyssey Mandarin Sky, Khamrah y Hawas sobre piedra malva.', width: 1448, height: 1086 },
  { src: '/brand/inicio/hawas-costa-verde.webp', alt: 'Un hombre se aplica Hawas con una Toyota 4Runner al fondo en la Costa Verde de Lima.', width: 1200, height: 960 },
  { src: '/brand/inicio/club-de-nuit-costa-norte.webp', alt: 'Un hombre vestido de negro se aplica Club de Nuit junto a una Mazda frente a una playa del norte peruano.', width: 1200, height: 960 },
  { src: '/brand/inicio/qahwa-ruta-andina.webp', alt: 'Una pareja comparte Khamrah Qahwa junto a una Hilux, entre una laguna turquesa y nevados andinos.', width: 1200, height: 960 },
];
---
<div class="hero-photo" data-hero-photos>
  {photos.map(({ src, alt, width, height }, index) => (
    <img src={index === 0 ? src : undefined} data-src={index ? src : undefined} alt={alt}
      data-current={index === 0 || undefined} aria-hidden={index !== 0 ? 'true' : undefined}
      width={width} height={height} fetchpriority={index ? 'low' : 'high'} />
  ))}
  <div class="hero-photo-controls" role="group" aria-label="Imágenes de inicio" hidden>
    <button type="button" data-photo-step="-1" aria-label="Imagen anterior"><ChevronLeft size={18} aria-hidden="true" /></button>
    <span data-photo-count aria-hidden="true">1 / {photos.length}</span>
    <button type="button" data-photo-step="1" aria-label="Imagen siguiente"><ChevronRight size={18} aria-hidden="true" /></button>
    <button type="button" data-photo-toggle aria-label="Pausar rotación">
      <Pause size={16} aria-hidden="true" class="pause-icon" />
      <Play size={16} aria-hidden="true" class="play-icon" />
    </button>
  </div>
  <span class="sr-only" role="status" data-photo-status></span>
</div>
<style>
  img { opacity: 0; transition: opacity .75s cubic-bezier(.3,.1,.25,1); }
  img[data-current] { opacity: 1; }
  .hero-photo-controls {
    position: absolute;
    z-index: 1;
    inset-inline-end: clamp(10px, 2vw, 23px);
    inset-block-end: clamp(10px, 2vw, 23px);
    display: flex;
    align-items: center;
    border: 1px solid #f6eaff5c;
    border-radius: 100px;
    background: #251530e8;
    color: #fff;
  }
  .hero-photo-controls[hidden] { display: none; }
  button { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; color: inherit; border-radius: 50%; }
  button:hover { background: #fff2; }
  button:focus-visible { outline: 2px solid #fff; outline-offset: -4px; }
  [data-photo-count] { font-size: .75rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  [data-photo-toggle] { margin-inline-start: 2px; }
  :global([data-hero-photos][data-paused]) .pause-icon, :global([data-hero-photos]:not([data-paused])) .play-icon { display: none; }
  @media (prefers-reduced-motion: reduce) { img { transition: none; } }
</style>
<script>
  const gallery = document.querySelector<HTMLElement>('[data-hero-photos]');
  if (gallery) {
    const photos = [...gallery.querySelectorAll('img')];
    const controls = gallery.querySelector<HTMLElement>('.hero-photo-controls')!;
    const toggle = gallery.querySelector<HTMLButtonElement>('[data-photo-toggle]')!;
    const count = gallery.querySelector<HTMLElement>('[data-photo-count]')!;
    const status = gallery.querySelector<HTMLElement>('[data-photo-status]')!;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const hover = window.matchMedia('(hover: hover)');
    let active = 0;
    let timer: number | undefined;
    let paused = motion.matches;
    let visible = !('IntersectionObserver' in window);
    let hovering = false;
    let focused = false;
    let loading = false;
    const advanceAfter = 7000;

    async function prepare(photo: HTMLImageElement) {
      if (photo.dataset.src && !photo.hasAttribute('src')) photo.src = photo.dataset.src;
      await photo.decode();
    }

    function schedule() {
      window.clearTimeout(timer);
      if (paused || hovering || focused || !visible || document.hidden || loading) return;
      void prepare(photos[(active + 1) % photos.length]).catch(() => {});
      timer = window.setTimeout(() => void show(1), advanceAfter);
    }

    async function show(step: number, manual = false) {
      if (loading) return;
      window.clearTimeout(timer);
      loading = true;
      const next = (active + step + photos.length) % photos.length;
      try {
        await prepare(photos[next]);
        if (!manual && (paused || hovering || focused || !visible || document.hidden)) return;
        photos[active].removeAttribute('data-current');
        photos[active].setAttribute('aria-hidden', 'true');
        photos[next].setAttribute('data-current', '');
        photos[next].removeAttribute('aria-hidden');
        active = next;
        count.textContent = `${active + 1} / ${photos.length}`;
        if (manual) status.textContent = `Imagen ${active + 1} de ${photos.length}. ${photos[active].alt}`;
      } catch {
        if (manual) status.textContent = 'No pudimos cargar la imagen. Vuelve a intentarlo.';
      } finally {
        loading = false;
        schedule();
      }
    }

    function setPaused(value: boolean) {
      paused = value;
      gallery!.toggleAttribute('data-paused', paused);
      toggle.setAttribute('aria-label', paused ? 'Reproducir rotación' : 'Pausar rotación');
      schedule();
    }

    controls.querySelectorAll<HTMLButtonElement>('[data-photo-step]').forEach(button => {
      button.addEventListener('click', () => void show(Number(button.dataset.photoStep), true));
    });
    toggle.addEventListener('click', () => setPaused(!paused));
    motion.addEventListener('change', () => setPaused(motion.matches));
    document.addEventListener('visibilitychange', schedule);
    gallery.addEventListener('pointerenter', () => { hovering = hover.matches; schedule(); });
    gallery.addEventListener('pointerleave', () => { hovering = false; schedule(); });
    controls.addEventListener('focusin', () => { focused = true; schedule(); });
    controls.addEventListener('focusout', event => {
      focused = controls.contains(event.relatedTarget as Node | null);
      schedule();
    });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; schedule(); }, { threshold: .25 }).observe(gallery);
    }
    setPaused(paused);
    controls.hidden = false;
  }
</script>

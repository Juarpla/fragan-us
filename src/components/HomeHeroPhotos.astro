---
const photos = [
  { src: '/brand/hero-perfumes.webp', alt: 'Odyssey Mandarin Sky, Khamrah y Hawas sobre piedra malva.', width: 1448, height: 1086 },
  { src: '/brand/inicio/hawas-costa-verde.webp', alt: 'Un hombre sostiene Hawas sentado en la puerta de una Toyota 4Runner, frente a la Costa Verde de Lima.', width: 1200, height: 900 },
  { src: '/brand/inicio/club-de-nuit-costa-norte.webp', alt: 'Un hombre se aplica Club de Nuit en el antebrazo junto a una SUV Mazda en la costa norte peruana.', width: 1200, height: 960 },
  { src: '/brand/inicio/qahwa-ruta-andina.webp', alt: 'Una pareja con Khamrah Qahwa se sienta en la compuerta de una Hilux frente a la Laguna 69.', width: 1200, height: 960 },
];
---
<div class="hero-photo" data-hero-photos>
  {photos.map(({ src, alt, width, height }, index) => (
    <img src={index === 0 ? src : undefined} data-src={index ? src : undefined} alt={alt}
      data-current={index === 0 || undefined} aria-hidden={index !== 0 ? 'true' : undefined}
      width={width} height={height} fetchpriority={index ? 'low' : 'high'} />
  ))}
</div>

<style>
  .hero-photo { isolation: isolate; }
  img { opacity: 0; }
  img[data-previous] { z-index: 1; opacity: 1; }
  img[data-current] { z-index: 2; opacity: 1; transition: opacity .75s cubic-bezier(.3,.1,.25,1); }
  @media (prefers-reduced-motion: reduce) { img[data-current] { transition: none; } }
</style>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-hero-photos]');
  if (gallery) {
    const photos = [...gallery.querySelectorAll('img')];
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let visible = !('IntersectionObserver' in window);
    let current = 0;
    let upcoming = 1;
    let previous: HTMLImageElement | undefined;
    let timer: number | undefined;
    let advancing = false;

    const shouldRotate = () => visible && !document.hidden && !motion.matches;

    function schedule() {
      window.clearTimeout(timer);
      if (!shouldRotate() || advancing) return;
      const next = photos[upcoming];
      if (next.dataset.src && !next.hasAttribute('src')) next.src = next.dataset.src;
      timer = window.setTimeout(() => void advance(), 7000);
    }

    async function advance() {
      const next = photos[upcoming];
      advancing = true;
      try {
        await next.decode();
        if (!shouldRotate()) return;
        previous?.removeAttribute('data-previous');
        previous = photos[current];
        previous.setAttribute('data-previous', '');
        previous.removeAttribute('data-current');
        previous.setAttribute('aria-hidden', 'true');
        next.setAttribute('data-current', '');
        next.removeAttribute('aria-hidden');
        current = upcoming;
      } catch {
        // Leave the current photo visible if the next one fails to load.
      } finally {
        if (shouldRotate() || current === upcoming) {
          do { upcoming = (upcoming + 1) % photos.length; } while (upcoming === current);
        }
        advancing = false;
        schedule();
      }
    }

    motion.addEventListener('change', schedule);
    document.addEventListener('visibilitychange', schedule);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        visible = entry.intersectionRatio >= .25;
        schedule();
      }, { threshold: .25 }).observe(gallery);
    } else {
      schedule();
    }
  }
</script>

---
import { MapPin } from '@lucide/astro';
---
<section class="checkout-group agency-picker" data-agency-picker aria-labelledby="agency-heading">
  <div class="agency-heading">
    <h2 id="agency-heading">Agencia de recojo</h2>
    <p>Selecciona la zona donde quieres recoger tu pedido.</p>
  </div>
  <div class="fields agency-area">
    <div class="field"><label for="agency-department">Departamento</label><select id="agency-department" name="department" required disabled></select></div>
    <div class="field"><label for="agency-province">Provincia</label><select id="agency-province" name="province" required disabled></select></div>
    <div class="field"><label for="agency-district">Distrito</label><select id="agency-district" name="ubigeo" required disabled></select></div>
  </div>
  <p class="agency-status" data-agency-status role="status">Cargando el listado de agencias…</p>
  <button class="button secondary" type="button" data-reload-agencies hidden>Reintentar carga</button>
  <div class="agency-choice" data-agency-field hidden>
    <div class="field"><label for="agency-branch">Agencia</label><select id="agency-branch" name="agency" aria-describedby="agency-address" required disabled></select></div>
    <div class="agency-selection" id="agency-address" data-agency-selection hidden>
      <MapPin size={20} aria-hidden="true" />
      <div>
        <p class="agency-region" data-agency-region></p>
        <p class="agency-street" data-agency-street></p>
        <p class="agency-reference" data-agency-reference hidden></p>
        <p class="agency-outside" data-agency-outside hidden>Fuera del distrito elegido</p>
      </div>
    </div>
  </div>
</section>

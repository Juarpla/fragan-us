---
import FragranceVisual from './FragranceVisual.astro';
import { Plus } from '@lucide/astro';
import { money, type Product } from '../lib/catalog';
const { product, catalogQuery = '', highlight, heading: Heading = 'h3' } = Astro.props as { product: Product; catalogQuery?: string; highlight?: string; heading?: 'h2' | 'h3' };
const { slug, name, brand, stock, price_cents, image_url, volume, concentration, family } = product;
const detailsHref = `/perfumes/${slug}${catalogQuery}`;
const tastingNote = highlight ?? product.notes.opening?.split(',')[0]?.trim();
---
<article class="product-card">
  <FragranceVisual product={product} href={detailsHref} />
  <div class="product-meta">
    <Heading class="product-name"><a href={detailsHref}>{name}</a></Heading>
    <p class="product-brand">{brand}</p>
    <p class="product-description">{concentration} · {volume} ml <span aria-hidden="true"> / </span> {family}</p>
    {tastingNote && <p class="product-note">{tastingNote}</p>}
    <div class="product-bottom">
      <strong>{money(price_cents)}</strong>
      <button class="product-add" type="button" aria-label={stock ? `Agregar ${name} a la bolsa` : `${name} agotado`} data-add={JSON.stringify({ slug, name, brand, stock, price_cents, image_url })} disabled={!stock}>
        {stock ? <><Plus size={16} stroke-width={1.9} aria-hidden="true" /> Agregar</> : 'Agotado'}
      </button>
    </div>
  </div>
</article>

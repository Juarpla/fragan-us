---
import { ArrowUpRight, Copy, Truck } from '@lucide/astro';
import { adminDate, orderWhatsApp } from '../lib/admin-orders';
import { money } from '../lib/catalog';
import { documentFormat } from '../lib/checkout-document';
import { shippingLabels } from '../lib/http';
import { orderItems, orderStatusLabel, type OrderRow } from '../lib/orders';

interface Props {
  orders: OrderRow[];
  filter: string;
  query: string;
  page: number;
  hasNext: boolean;
}

const { orders, filter, query, page, hasNext } = Astro.props;
---
<div data-order-results data-page={page}>
  {orders.length ? orders.map(order => {
    const whatsApp = orderWhatsApp(order, Astro.url.origin);
    const documentLabel = documentFormat(order.document_type)?.label ?? 'Documento';
    const perfumes = orderItems(order.items_json).map(({ quantity, name, brand, volume }) => {
      const fullName = brand ? `${name} de ${brand}` : name;
      return `${quantity} × ${fullName}${volume ? ` · ${volume} ml` : ''}`;
    });
    const dispatchData = [
      `Cliente: ${order.customer_name}`,
      `Celular: +51 ${order.customer_phone}`,
      `${documentLabel}: ${order.document_number ?? 'Sin registrar'}`,
      `Destino: ${order.shipping_address ? `${order.shipping_method === 'SHALOM' ? 'Shalom · ' : ''}${order.shipping_address}` : order.city}`,
      ...perfumes.map(perfume => `Perfume: ${perfume}`),
    ].map(line => `• ${line}`).join('\n');
    return <article class="admin-record admin-order" data-copy-region>
      <header class="admin-order-heading">
        <div><h3>{order.order_code}</h3><p class="muted">{adminDate(order.created_at)}{order.is_demo === 1 && ' · Prueba'}</p></div>
        <div><strong>{money(order.total_cents)}</strong>{order.payment_method && <p class="muted">{order.payment_method}</p>}</div>
      </header>
      <div class="admin-order-details">
        <div><h4>Cliente</h4><p>{order.customer_name} · +51 {order.customer_phone}</p><p class="muted">{documentLabel} · {order.document_number ?? 'Sin registrar'}</p>
          {order.whatsapp_offers === 1 && <p class="muted">Aceptó recibir actualizaciones por WhatsApp.</p>}</div>
        <div><h4>Perfumes</h4><ul>{perfumes.map(perfume => <li>{perfume}</li>)}</ul></div>
        <div class="admin-order-destination"><h4>Destino</h4><p>{order.city} · {shippingLabels[order.shipping_method]}</p><p class="muted">{order.shipping_address}</p></div>
      </div>
      {(query || filter === 'ARCHIVE') && <p class="admin-order-note">{orderStatusLabel[order.status]}</p>}
      {order.status === 'PENDING_VERIFICATION' && order.stock_reserved === 0 && <p class="notice admin-order-note">Comprueba el stock antes de confirmar el pago.</p>}
      <div class="admin-record-actions">
        {order.status === 'PENDING_CONFIRMATION' && <button class="button primary" data-order={order.order_code} data-action="enable_payment">Habilitar pago</button>}
        {order.status === 'PENDING_VERIFICATION' && <button class="button primary" data-order={order.order_code} data-action="pay">Confirmar pago</button>}
        {order.status === 'SHIPPED' && order.shipping_receipt_key && <a class="button secondary" href={`/admin/comprobante/${order.order_code}`}>Ver comprobante de envío</a>}
        {order.status !== 'SHIPPED' && order.receipt_r2_key && <a class="button secondary" href={`/api/admin/receipt?code=${order.order_code}`} rel="noreferrer" target="_blank">Ver comprobante de pago</a>}
        {['PAID', 'PACKING', 'SHIPPED'].includes(order.status) && <button class="button secondary" type="button" data-copy-value={dispatchData} data-copy-success="Datos de envío copiados."><Copy size={16} aria-hidden="true" /> Copiar datos de envío</button>}
        {order.is_demo !== 1 && <a class="button secondary" href={whatsApp.href} rel="noreferrer" target="_blank">{whatsApp.label} <ArrowUpRight size={15} aria-hidden="true" /></a>}
        {['PENDING_CONFIRMATION', 'PENDING_VERIFICATION'].includes(order.status) && <button class="button secondary" data-order={order.order_code} data-action="cancel">Cancelar pedido</button>}
      </div>
      <p class="error-message" role="alert"></p>
      <p class="muted admin-copy-status" role="status" data-copy-message></p>
      <textarea class="admin-copy-fallback" aria-label="Datos de envío para copiar" data-copy-fallback readonly hidden></textarea>
      {['PAID', 'PACKING', 'SHIPPED'].includes(order.status) && <details class="admin-editor admin-dispatch">
        <summary><Truck size={18} aria-hidden="true" /> {order.status === 'SHIPPED' ? 'Editar datos de envío' : 'Registrar envío'}</summary>
        <form data-dispatch-form class="admin-editor-form" action="/api/admin/dispatch" method="post" enctype="multipart/form-data">
          <input type="hidden" name="code" value={order.order_code} />
          <input type="hidden" name="previousReceipt" value={order.shipping_receipt_key ?? ''} />
          <input type="hidden" name="previousPassword" value={order.pickup_password ?? ''} />
          <label class="field">Comprobante del transportista
            <input name="receipt" type="file" accept="application/pdf,image/jpeg,image/png,image/webp" required={!order.shipping_receipt_key} />
            <span class="muted">PDF, JPG, PNG o WebP, hasta 8 MB.</span>
          </label>
          <label class="field">Clave de recojo
            <input name="password" maxlength="80" value={order.pickup_password ?? ''} autocomplete="off" required />
          </label>
          <div class="admin-editor-actions">
            {order.shipping_receipt_key && <a class="button secondary" href={`/api/orders/shipping-receipt?code=${order.order_code}`} download>Descargar comprobante actual</a>}
            <button class="button primary" type="submit">{order.status === 'SHIPPED' ? 'Guardar datos de envío' : 'Marcar como enviado'}</button>
          </div>
          <p class="error-message" role="alert"></p>
        </form>
      </details>}
    </article>;
  }) : <p class="admin-empty">{query ? 'No se encontraron pedidos con estos datos.' : filter === 'ARCHIVE' ? 'Aún no hay pedidos en el historial.' : 'No hay pedidos en esta etapa.'}</p>}
  {(page > 1 || hasNext) && <nav class="checkout-actions" aria-label="Páginas de pedidos">
    {page > 1 && (query ? <button class="button secondary" type="submit" form="order-search" name="p" value={page - 1}>Anterior</button> : <a class="button secondary" href={`/admin/pedidos?estado=${filter}&p=${page - 1}#order-list`}>Anterior</a>)}
    {hasNext && (query ? <button class="button secondary" type="submit" form="order-search" name="p" value={page + 1}>Siguiente</button> : <a class="button secondary" href={`/admin/pedidos?estado=${filter}&p=${page + 1}#order-list`}>Siguiente</a>)}
  </nav>}
</div>

---
import { ArrowRight, CircleCheck, RefreshCw } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import { money } from '../../lib/catalog';
import { checkoutMode, validCode } from '../../lib/http';
import { canSubmitReceipt, customerStatusLabel, expireReservations, isPayable, type OrderRow } from '../../lib/orders';
import { storeEnv } from '../../lib/runtime';

const code = Astro.params.code;
type OrderStatus = Pick<OrderRow, 'order_code' | 'total_cents' | 'status' | 'is_demo'>;
const db = storeEnv.DB;
const order = validCode(code) && db && await expireReservations(db).then(() => db.prepare(
  'SELECT order_code, total_cents, status, is_demo FROM orders WHERE order_code = ?',
).bind(code).first<OrderStatus>());
if (!order) Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
const message: Record<string, string> = {
  PENDING_CONFIRMATION: 'Estamos revisando tu solicitud. Consulta este enlace para saber cuándo podrás pagar.',
  AWAITING_PAYMENT: 'Paga los perfumes por Yape o Plin y adjunta el comprobante.',
  EXPIRED: 'La reserva venció. Si ya pagaste, todavía puedes enviar tu comprobante para que lo revisemos.',
  PENDING_VERIFICATION: 'Recibimos tu comprobante. Verificaremos el abono antes de confirmar tu pedido.',
  PAID: 'Verificamos tu pago. Tu pedido está en espera de preparación.',
  PACKING: 'Confirmamos tu pedido y lo estamos preparando para enviarlo a la agencia que elegiste.',
  SHIPPED: 'Tu pedido está en camino a la agencia de destino.',
  CANCELLED: 'El pedido fue cancelado.',
};
const mode = checkoutMode(storeEnv);
const payable = order && isPayable(order, mode);
const submitReceipt = order && canSubmitReceipt(order, mode);
---
<Base title="Estado del pedido" minimal privatePage>
  <section class="container inner-section">
    {order ? <div class="order-result">
      <CircleCheck size={39} stroke-width={1.6} class="text-purple-700" aria-hidden="true" />
      <h1 class="inner-title">{order.status === 'PENDING_CONFIRMATION' ? 'Recibimos tu solicitud' : 'Estado de tu pedido'}</h1>
      {order.is_demo === 1 && <p class="notice">Pedido de prueba.</p>}
      <p class="inner-copy">{message[order.status]}</p>
      <div class="panel">
        <p class="muted">Código del pedido</p><code class="order-code">{order.order_code}</code>
        <p class="mt-3"><strong>{customerStatusLabel[order.status]}</strong></p>
        <p class="order-freight"><span>Total en productos</span><strong>{money(order.total_cents)}</strong></p>
        {order.status !== 'CANCELLED' && <p class="muted mt-2">El transportista fija y cobra el flete por separado.</p>}
        <p class="muted mt-2">Guarda el enlace para consultar el estado.</p>
      </div>
      <div class="checkout-actions">
        {submitReceipt && <a class="button primary" href={`/pago/${order.order_code}`}>{payable ? 'Continuar al pago' : 'Enviar comprobante'} <ArrowRight size={17} aria-hidden="true" /></a>}
        {!payable && <a class={`button ${submitReceipt ? 'secondary' : 'primary'}`} href="/#catalogo">Volver a la tienda <ArrowRight size={17} aria-hidden="true" /></a>}
        <a class="button secondary" href={`/gracias/${order.order_code}`}>Actualizar estado <RefreshCw size={16} aria-hidden="true" /></a>
      </div>
    </div> : <div><h1 class="inner-title">Pedido no encontrado</h1><p class="inner-copy">Revisa el código del enlace de confirmación.</p><a class="button primary" href="/">Ir a la tienda <ArrowRight size={17} aria-hidden="true" /></a></div>}
  </section>
</Base>

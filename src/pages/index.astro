---
import { ArrowDown, ArrowRight, CreditCard, Gift, MapPin, MoonStar, ShieldCheck, Snowflake, Sparkles, Sun, Truck, Wind } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { catalogGroups, catalogHref, catalogParams, catalogSelection } from '../lib/catalog-filters';
import { getCatalog } from '../lib/db';
import { storeEnv } from '../lib/runtime';

const products = await getCatalog(storeEnv);
const { query, filter } = catalogSelection(Astro.url.searchParams);
const terms = (text: string) => text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
const matches = products.filter(product => {
  const tags = [...product.collections, ...product.climate, ...product.occasions, { 'Para él': 'el', 'Para ella': 'ella', Unisex: 'unisex' }[product.audience]];
  const searchable = terms([product.name, product.brand, product.family, product.audience, ...Object.values(product.notes)].join(' '));
  return (!filter || tags.includes(filter)) && (!query || terms(query).split(/\s+/).every(word => searchable.includes(word)));
});
const filterIcons = { calido: Sun, fresco: Snowflake, diario: Wind, noche: MoonStar, regalo: Gift };
const featured = [
  { name: 'Odyssey Mandarin Sky', brand: 'Armaf', photo: 'odyssey-mandarin-sky.jpg', size: 720, tone: 'mandarin' },
  { name: 'Khamrah', brand: 'Lattafa', photo: 'khamrah.webp', size: 400, tone: 'amber' },
  { name: 'Hawas for Him', brand: 'Rasasi', photo: 'hawas-for-him.jpg', size: 720, tone: 'lilac' },
];
---
<Base>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">El perfume es<br /><em>parte de ti.</em></h1>
      <p>Descubre perfumes árabes importados que van con tu estilo, tu clima y tus planes.</p>
      <div class="hero-actions">
        <a class="button primary" href={catalogHref(filter, query)}>Explorar perfumes <ArrowRight size={19} aria-hidden="true" /></a>
        <a class="button secondary" href={catalogHref(filter, query, 'climas')}>Elegir por clima <ArrowDown size={17} aria-hidden="true" /></a>
      </div>
    </div>
    <figure class="hero-featured" aria-label="Perfumes destacados">
      {featured.map(({ brand, name, photo, size, tone }) =>
        <div class:list={['featured-perfume', `featured-${tone}`]}>
          <img src={`/brand/destacados/${photo}`} alt={`Frasco y caja de ${name} de ${brand}`} width={size} height={size} />
          <div class="featured-name" aria-hidden="true"><span>{brand}</span><strong>{name}</strong></div>
        </div>
      )}
    </figure>
  </section>

  <div class="container assurances" aria-label="Información de compra">
    <div><span class="assurance-icon"><Truck size={21} stroke-width={1.7} aria-hidden="true" /></span><div><strong>Envíos a todo el Perú</strong><p>Exclusivamente por Shalom</p></div></div>
    <div><span class="assurance-icon"><CreditCard size={21} stroke-width={1.7} aria-hidden="true" /></span><div><strong>Pago con Yape o Plin</strong><p>Después de confirmar tu pedido</p></div></div>
    <div><span class="assurance-icon"><Sparkles size={21} stroke-width={1.7} aria-hidden="true" /></span><div><strong>Selección por clima y ocasión</strong><p>Encuentra un aroma para tu plan</p></div></div>
  </div>

  <section class="container catalog-section" id="catalogo" aria-labelledby="catalog-title">
    <div class="section-heading">
      <div><h2 id="catalog-title">Encuentra tu aroma</h2><p>Explora fragancias dulces, frescas y especiadas.</p></div>
    </div>
    <nav id="guia" class="catalog-filters" aria-label="Filtrar perfumes">
      {catalogGroups.map(({ label, id, options }) =>
        <div class="catalog-filter-group" id={id} tabindex="-1" role="group" aria-label={label}>
          <span class="catalog-filter-label">{label}</span>
          <div class="filters">
            {Object.entries(options).map(([value, text]) => {
              const Icon = filterIcons[value as keyof typeof filterIcons];
              return <a href={catalogHref(filter === value ? '' : value, query, id)} class:list={['filter', value === filter && 'selected']} aria-current={value === filter ? 'true' : undefined}>{Icon && <Icon size={16} aria-hidden="true" />}{text}</a>;
            })}
          </div>
        </div>
      )}
    </nav>
    <div class="query-status">
      <p>{query && <>Resultados para «{query}» <span>· </span></>}<span>{matches.length} {matches.length === 1 ? 'perfume' : 'perfumes'}</span></p>
      {(query || filter) && <a class="inline-link" href="/#catalogo">Ver todos</a>}
    </div>
    {matches.length ? <div class="product-grid">{matches.map(product => <ProductCard product={product} catalogQuery={catalogParams(filter, query)} />)}</div> :
      <div class="empty-card"><h3>No encontramos perfumes</h3><p>Prueba con otro nombre, otra nota o vuelve a la colección.</p><a class="button secondary" href="/#catalogo">Ver todos los perfumes</a></div>}
  </section>

  <section class="container delivery-section" id="envios" aria-labelledby="delivery-title">
    <h2 id="delivery-title">Envíos a todo el Perú</h2>
    <div class="delivery-details">
      <div><Truck size={23} aria-hidden="true" /><h3>Despacho por Shalom</h3><p>Indica tu ciudad y la agencia de Shalom de tu preferencia al solicitar el pedido.</p></div>
      <div><MapPin size={23} aria-hidden="true" /><h3>Flete por pagar</h3><p>Te confirmamos la cobertura y el costo por WhatsApp. Paga el flete directamente a Shalom.</p></div>
      <div><ShieldCheck size={23} aria-hidden="true" /><h3>Pago de los perfumes</h3><p>Paga por Yape o Plin cuando confirmemos tu pedido. Guarda tu código para consultar el estado.</p></div>
    </div>
  </section>
</Base>

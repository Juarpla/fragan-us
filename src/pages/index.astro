---
import { ArrowDown, ArrowRight, CreditCard, MapPin, Sparkles, Truck } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { catalogHref, catalogSelection } from '../lib/catalog-filters';
import { getCatalog } from '../lib/db';
import { storeEnv } from '../lib/runtime';

const { query, filters, page } = catalogSelection(Astro.url.searchParams);
if (query || filters.length || page > 1) return Astro.redirect(catalogHref(filters, query, page), 302);

const products = await getCatalog(storeEnv);
const highlights = new Map([
  ['khamrah', 'Canela y dátiles'],
  ['yara', 'Floral para el día a día'],
  ['asad', 'Para noches frescas'],
  ['qaed-al-fursan', 'Piña sobre maderas'],
]);
const curated = [...highlights.keys()].flatMap(slug => products.find(product => product.slug === slug) ?? []);
const featured = [...curated, ...products.filter(product => !highlights.has(product.slug))].slice(0, 4);
---
<Base>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">El perfume es <span class="sr-only">parte de ti.</span>
        <em class="hero-phrase" aria-hidden="true">
          <span>parte de ti.</span>
          <span>tu nota final.</span>
          <span>tu sello único.</span>
        </em>
      </h1>
      <p>Descubre perfumes importados que van con tu estilo, tu clima y tus planes.</p>
      <div class="hero-actions">
        <a class="button primary" href={catalogHref()}>Explorar perfumes <ArrowRight size={19} aria-hidden="true" /></a>
        <a class="button secondary" href="/perfumes#climas">Elegir por clima <ArrowDown size={17} aria-hidden="true" /></a>
      </div>
    </div>
    <div class="hero-photo">
      <img src="/brand/hero-perfumes.webp" alt="Tres perfumes sobre piedra malva: Odyssey Mandarin Sky de Armaf, Khamrah de Lattafa y Hawas for Him de Rasasi." width="1448" height="1086" fetchpriority="high" />
    </div>
  </section>

  <div class="container assurances" aria-label="Información de compra">
    <div><span class="assurance-icon"><Truck size={21} stroke-width={1.7} aria-hidden="true" /></span><div><strong><a href="/envios">Envíos a todo el Perú</a></strong><p class="assurance-shipping">Llegamos por Shalom</p></div></div>
    <div><span class="assurance-icon"><CreditCard size={21} stroke-width={1.7} aria-hidden="true" /></span><div><strong>Pago con Yape o Plin</strong><p>Confirmamos el pago antes de preparar tu pedido</p></div></div>
    <div><span class="assurance-icon"><Sparkles size={21} stroke-width={1.7} aria-hidden="true" /></span><div><strong>Selección por clima y ocasión</strong><p>Encuentra un aroma para tu plan</p></div></div>
  </div>

  <section class="container catalog-section home-featured" id="catalogo" aria-labelledby="catalog-title">
    <div class="section-heading">
      <h2 id="catalog-title">Perfumes destacados</h2>
      <a class="inline-link" href="/perfumes">Ver todos los perfumes <ArrowRight size={17} aria-hidden="true" /></a>
    </div>
    {featured.length > 0 ? <div class="product-grid">{featured.map(product => <ProductCard product={product} highlight={highlights.get(product.slug)} />)}</div> :
      <p class="muted">Aún no hay perfumes en el catálogo.</p>}
  </section>

  <section class="container home-shipping" id="envios" aria-labelledby="home-shipping-title">
    <div>
      <h2 id="home-shipping-title">Envíos a todo el Perú</h2>
      <a class="inline-link" href="/envios">Cómo funcionan los envíos <ArrowRight size={16} aria-hidden="true" /></a>
    </div>
    <div class="home-shipping-details">
      <div><Truck size={22} aria-hidden="true" /><h3>Envío por agencia</h3><p>Por ahora enviamos preferentemente por Shalom. Elige tu agencia al finalizar la compra.</p></div>
      <div><MapPin size={22} aria-hidden="true" /><h3>Flete por separado</h3><p>El transportista cobra el flete cuando recoges tu pedido.</p></div>
    </div>
  </section>
</Base>

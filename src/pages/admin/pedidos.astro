---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminOrderResults from '../../components/AdminOrderResults.astro';
import { guardAdmin, isSameOrigin } from '../../lib/http';
import { storeEnv } from '../../lib/runtime';
import { Archive, FileCheck, PackageCheck, RefreshCw, Search, Truck } from '@lucide/astro';
import { orderStages } from '../../lib/orders';
import { loadAdminOrders } from '../../lib/admin-orders';

const denied = await guardAdmin(Astro.request, storeEnv);
if (denied) return denied;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'same-origin');

const db = storeEnv.DB;
if (!db) return new Response('Base de datos no disponible.', { status: 503 });
if (Astro.request.method === 'POST' && !isSameOrigin(Astro.request)) return new Response(null, { status: 403 });
const resultsProps = await loadAdminOrders(db, Astro.request, Astro.url);
const { filter, query, label } = resultsProps;
const stageIcons = [FileCheck, PackageCheck, Truck];
---
<AdminLayout title="Pedidos" current="pedidos">
  <div class="admin-layout">
    <nav class="admin-section-nav" aria-label="Estados de pedido">
      <ol class="admin-status-list" role="list">
        {orderStages.map(({ id, label }, index) => {
          const Icon = stageIcons[index];
          return <li><a href={`/admin/pedidos?estado=${id}#order-list`} aria-current={filter === id ? 'page' : undefined}>
            <span class="admin-stage-icon"><Icon size={19} aria-hidden="true" /></span><span>{label}</span>
          </a></li>;
        })}
      </ol>
      <a class="admin-archive" href="/admin/pedidos?estado=ARCHIVE#order-list" aria-current={filter === 'ARCHIVE' ? 'page' : undefined}><Archive size={18} aria-hidden="true" /> Solicitudes anteriores</a>
    </nav>
    <section class="panel admin-section" aria-labelledby="order-list" data-admin-orders>
      <div class="admin-orders-heading">
        <div><h2 id="order-list" tabindex="-1">Pedidos</h2><p class="muted">{query ? 'Resultados en todas las etapas' : label}</p></div>
        <form id="order-search" class="admin-order-search" method="post" action={`/admin/pedidos?estado=${filter}`}>
          <label class="field" for="customer-search">Buscar pedidos</label>
          <div>
            <input id="customer-search" name="q" type="search" value={query} maxlength="90" autocomplete="off" placeholder="Código, nombre, DNI o carné" required />
            <button class="button secondary" type="submit"><Search size={17} aria-hidden="true" /> Buscar</button>
            <button type="button" class="button secondary admin-refresh" aria-label="Actualizar pedidos" title="Actualizar pedidos" data-order-refresh hidden>
              <RefreshCw size={18} aria-hidden="true" />
            </button>
          </div>
          {query && <a class="inline-link" href={`/admin/pedidos?estado=${filter}`}>Limpiar búsqueda</a>}
        </form>
      </div>

      <p class="muted admin-refresh-status" role="status" data-order-feedback></p>
      <AdminOrderResults {...resultsProps} />
    </section>
  </div>
</AdminLayout>
<script>
  import '../../scripts/clipboard-value';
  import '../../scripts/admin-orders-ui';
</script>

---
import { ArrowRight, Truck } from '@lucide/astro';
import AgencyPicker from '../components/AgencyPicker.astro';
import Base from '../layouts/Base.astro';
import { documentFormats } from '../lib/checkout-document';
import { checkoutMode } from '../lib/http';
import { storeEnv } from '../lib/runtime';

const mode = checkoutMode(storeEnv);
Astro.response.headers.set('Cache-Control', 'no-store');
---
<Base title="Finalizar compra" minimal privatePage showCart>
  <section class="container inner-section checkout" data-checkout data-mode={mode}>
    <h1 class="checkout-title">Finaliza tu compra</h1>
    {mode === 'demo' && <p class="notice">Modo de prueba. Usa datos ficticios. No realices un pago.</p>}
    {mode === 'unavailable' && <p class="notice">El pago en línea aún no está habilitado.</p>}
    <div class="empty-card" data-checkout-empty hidden><h2>Tu bolsa está vacía</h2><p>Agrega un perfume para continuar.</p><a href="/perfumes" class="button primary">Ver perfumes <ArrowRight size={17} aria-hidden="true" /></a></div>
    <div class="checkout-grid" data-checkout-content hidden>
      <aside class="panel checkout-aside" aria-labelledby="checkout-summary">
        <div class="checkout-summary-heading"><h2 id="checkout-summary">Tu bolsa</h2><button type="button" class="inline-link" data-cart-open>Editar bolsa</button></div>
        <div class="checkout-list" data-checkout-list></div>
        <div class="checkout-total"><strong>Total en productos</strong><strong data-checkout-total></strong></div>
        <p class="checkout-freight"><Truck size={17} aria-hidden="true" /> <span>El transportista fija el costo del envío y lo cobra por separado.</span></p>
      </aside>
      <form class="panel checkout-form" data-order-form>
        <fieldset>
          <section class="checkout-group" aria-labelledby="checkout-contact">
            <h2 id="checkout-contact">Datos de contacto</h2>
            <div class="fields">
              <label class="field">Nombre completo<input name="name" autocomplete="name" maxlength="90" minlength="2" required /></label>
              <label class="field">WhatsApp<input name="phone" type="tel" autocomplete="tel-national" inputmode="tel" maxlength="17" placeholder="987 654 321" required /></label>
              <label class="field">Tipo de documento
                <select name="documentType" required><option value="">Selecciona tu documento</option>{Object.entries(documentFormats).map(([value, format]) => <option value={value}>{format.label}</option>)}</select>
              </label>
              <label class="field">Número de documento
                <input name="documentNumber" inputmode="numeric" autocomplete="off" maxlength="9" pattern="[0-9]{8,9}" aria-describedby="document-help" required />
                <span id="document-help" class="muted">DNI de 8 dígitos o carné de 9.</span>
              </label>
            </div>
          </section>
          <AgencyPicker />
          <div class="checkout-group checkout-finish">
            <div class="checkout-preferences">
              <label class="checkout-consent">
                <input type="checkbox" name="resume" />
                <span>Acepto recibir mensajes y actualizaciones por WhatsApp.</span>
              </label>
              <a href="/privacidad">Política de privacidad</a>
            </div>
            <div class="checkout-next">
              <button class="button primary" type="submit" data-confirm disabled>Continuar al pago <ArrowRight size={17} aria-hidden="true" /></button>
              <p class="error-message checkout-error" data-checkout-error role="alert"></p>
            </div>
          </div>
        </fieldset>
      </form>
    </div>
    <noscript><p>Activa JavaScript para revisar tu bolsa y continuar al pago.</p></noscript>
  </section>
</Base>
<script>
  import '../scripts/checkout-ui';
</script>

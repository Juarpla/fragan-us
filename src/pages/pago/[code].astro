---
import { ArrowLeft, ArrowRight, Clock3, Copy, Download, Upload } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import { money } from '../../lib/catalog';
import { checkoutMode, validCode } from '../../lib/http';
import { canSubmitReceipt, expireReservations, isPayable, type OrderRow } from '../../lib/orders';
import { storeEnv } from '../../lib/runtime';

const code = Astro.params.code;
const mode = checkoutMode(storeEnv);
const db = storeEnv.DB;
type PayableOrder = Pick<OrderRow, 'order_code' | 'total_cents' | 'reserved_until' | 'status' | 'is_demo'>;
const order = validCode(code) && db && await expireReservations(db).then(() => db.prepare(
  'SELECT order_code, total_cents, reserved_until, status, is_demo FROM orders WHERE order_code = ?',
).bind(code).first<PayableOrder>());
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
if (!order) Astro.response.status = 404;
const phone = mode === 'live' ? storeEnv.PAYMENT_PHONE : undefined;
const payable = order && isPayable(order, mode);
const qrHref = order && `/api/orders/payment-qr?code=${order.order_code}`;
const showQR = payable && mode === 'live' && Boolean(await storeEnv.RECEIPTS_BUCKET?.head('settings/payment-qr').catch(() => null));
const deadline = payable && order.reserved_until ? new Date(order.reserved_until.replace(' ', 'T') + 'Z') : null;
const serverTime = Date.now();
const seconds = deadline ? Math.max(0, Math.ceil((deadline.getTime() - serverTime) / 1000)) : 0;
const clock = [Math.floor(seconds / 60), seconds % 60].map(part => String(part).padStart(2, '0')).join(':');
---
<Base title="Pagar pedido" minimal privatePage>
  <section class="container inner-section payment-page" data-payment-page>
    {order && canSubmitReceipt(order, mode) ? <>
      <h1 class="inner-title">{payable ? 'Paga tus perfumes' : 'Envía tu comprobante'}</h1>
      <p class="inner-copy">Confirmaremos tu pedido al comprobar el pago.</p>
      {order.is_demo === 1 && <p class="notice">Modo de prueba. Usa un comprobante ficticio.</p>}
      <div class="panel payment-panel">
        <div class="payment-total"><div><h2>Pago Digital</h2><p>Importe de los perfumes</p></div><strong>{money(order.total_cents)}</strong></div>
        <p class="notice payment-alert" role="status" data-expired-payment hidden={payable}>La reserva venció. Si ya pagaste, adjunta el comprobante para que revisemos tu pedido. Si aún no pagaste, vuelve a la tienda para hacer un nuevo pedido.</p>
        {deadline && <div class="payment-reservation" data-payment-deadline={deadline.getTime()} data-server-time={serverTime}>
          <span><Clock3 size={19} aria-hidden="true" /> Tu reserva vence en</span>
          <time role="timer" aria-label="Tiempo restante de tu reserva" datetime={deadline.toISOString()}>{clock}</time>
        </div>}
        <div class="payment-content">
          {payable && phone && <div class="payment-destination" data-payment-destination>
            {showQR && qrHref && <a class="payment-qr" href={qrHref} target="_blank" rel="noopener noreferrer" aria-label="Abrir el QR de Yape en tamaño completo">
              <img src={qrHref} alt="Código QR de Yape para pagar a FraganUS" width="240" />
            </a>}
            <div class="payment-method-actions">
              {showQR && qrHref && <a class="button secondary payment-download" href={`${qrHref}&download=1`} download><Download size={16} aria-hidden="true" /> Descargar QR</a>}
              <button class="button secondary" type="button" data-copy={phone}><Copy size={16} aria-hidden="true" /> Copiar celular de pago</button>
            </div>
            <span role="status" data-copy-status></span>
          </div>}
          <form class="payment-receipt" method="post" action="/api/orders/receipt" enctype="multipart/form-data" data-receipt-form>
            <input type="hidden" name="code" value={order.order_code} />
            <label class="payment-upload">
              <span><Upload size={21} aria-hidden="true" /> <span data-upload-label>Subir comprobante de pago</span></span>
              <small id="receipt-format">JPG, PNG o WebP, hasta 8 MB.</small>
              <input class="sr-only" type="file" name="receipt" accept="image/jpeg,image/png,image/webp" aria-describedby="receipt-format" required />
            </label>
            <div class="payment-receipt-preview" data-receipt-preview hidden>
              <img alt="Vista previa del comprobante seleccionado" width="72" height="86" />
              <div><strong>Listo para enviar</strong><p class="muted payment-file-name" data-file-name></p></div>
            </div>
            <div class="payment-progress" data-receipt-progress hidden>
              <p class="muted" role="status"></p>
              <progress aria-label="Progreso del envío" max="1"></progress>
            </div>
            <button type="submit" class="button primary" data-send-receipt disabled><span data-receipt-label>Enviar comprobante</span> <ArrowRight size={17} aria-hidden="true" /></button>
            <p class="error-message" role="alert" data-receipt-error></p>
          </form>
        </div>
      </div>
      <a class="button secondary payment-back" href={`/gracias/${order.order_code}`}><ArrowLeft size={16} aria-hidden="true" /> Volver al pedido</a>
    </> : <>
      <h1 class="inner-title">{order ? 'Consulta el estado de tu pedido' : 'Pedido no encontrado'}</h1>
      <p class="inner-copy">{order ? 'Revisa el enlace de tu pedido para saber cuál es el siguiente paso.' : 'Revisa el código en el enlace que recibiste.'}</p>
      <a class="button primary" href={order ? `/gracias/${order.order_code}` : '/'}>{order ? 'Ver estado del pedido' : 'Ir a la tienda'} <ArrowRight size={17} aria-hidden="true" /></a>
    </>}
  </section>
</Base>
<script>
  import { setupReservationTimer } from '../../scripts/reservation-timer';
  import { setupPaymentReceipt } from '../../scripts/payment-receipt';
  import { showTemporaryStatus } from '../../scripts/temporary-status';

  const deadline = document.querySelector<HTMLElement>('[data-payment-deadline]');
  if (deadline) setupReservationTimer(deadline);

  const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
  copy?.addEventListener('click', async () => {
    const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]')!;
    try {
      await navigator.clipboard.writeText(copy.dataset.copy!);
      showTemporaryStatus(copyStatus, 'Número copiado.');
    } catch {
      showTemporaryStatus(copyStatus, 'No pudimos copiar el número. Revisa el acceso al portapapeles.');
    }
  });

  const form = document.querySelector<HTMLFormElement>('[data-receipt-form]');
  if (form) setupPaymentReceipt(form);
</script>

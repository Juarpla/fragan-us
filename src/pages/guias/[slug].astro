---
import { ArrowDown, ArrowRight, ChevronRight } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import GuideImage from '../../components/GuideImage.astro';
import GuideMap from '../../components/GuideMap.astro';
import { getGuide, guideImage } from '../../lib/guides';
import { publicStoreOrigin, storeEnv } from '../../lib/runtime';
import '../../styles/guides.css';

const guide = await getGuide(storeEnv.DB, Astro.params.slug ?? '');
if (!guide) Astro.response.status = 404;
const guideOrigin = publicStoreOrigin(Astro.url);
const content = guide?.content;
const sources = new Map(content?.sources.map(source => [source.id, source]));
const firstChapter = content?.chapters[0];
const showMap = content?.mapView && content.chapters.some(chapter => chapter.point);
---
<Base title={guide?.title ?? 'Guía no encontrada'} description={guide?.description}>
  <Fragment slot="head">
    {guide && <>
      <link rel="canonical" href={new URL(`/guias/${guide.slug}`, guideOrigin).href} />
      <meta property="og:type" content="article" />
      <meta property="og:title" content={guide.title} />
      <meta property="og:description" content={guide.description} />
      <meta property="og:image" content={new URL(guideImage(guide.cover_key, 1280), guideOrigin).href} />
    </>}
  </Fragment>
  {guide && content ? <article class="container guide-article">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a><ChevronRight size={14} aria-hidden="true" /><a href="/guias">Guías</a>
    </nav>
    <header class="guide-cover">
      <div class="guide-cover-copy">
        <h1>{guide.title}</h1>
        <p>{guide.description}</p>
        {firstChapter && <a class="button secondary guide-start" href={`#${firstChapter.id}`}>Empezar el recorrido <ArrowDown size={17} aria-hidden="true" /></a>}
      </div>
      <div class="guide-cover-media">
        <GuideImage imageKey={guide.cover_key} alt={guide.cover_alt} sizes="(max-width: 760px) calc(100vw - 32px), 670px" priority />
      </div>
    </header>
    <div class:list={['guide-journey', showMap && 'has-atlas']}>
      {showMap && content.mapView && <GuideMap chapters={content.chapters} view={content.mapView} />}
      <div class="guide-chapters">
        {content.chapters.map(chapter => (
          <section class="guide-chapter" id={chapter.id} aria-labelledby={`titulo-${chapter.id}`}>
            <h2 id={`titulo-${chapter.id}`}>{chapter.heading}</h2>
            {chapter.place && <p class="guide-place">{chapter.place}</p>}
            {chapter.body.map(paragraph => <p class="guide-paragraph">{paragraph}</p>)}
            {chapter.image && <figure>
              <GuideImage imageKey={chapter.image.key} alt={chapter.image.alt} sizes="(max-width: 760px) calc(100vw - 32px), 650px" />
              <figcaption>Ilustración editorial generada para FraganUS.</figcaption>
            </figure>}
            {chapter.sources?.length && <ul class="guide-inline-sources" aria-label="Fuentes del capítulo">
              {chapter.sources.map(id => {
                const source = sources.get(id);
                return source && <li><a href={source.href}>{source.label}</a></li>;
              })}
            </ul>}
          </section>
        ))}
      </div>
    </div>
    {content.comparison && <section class="guide-comparison" aria-labelledby="comparacion">
      <h2 id="comparacion">{content.comparison.heading}</h2>
      <p>{content.comparison.description}</p>
      <div class="guide-comparison-groups">
        {content.comparison.groups.map(group => <div>
          <h3>{group.heading}</h3>
          <p>{group.scope}</p>
          <ul>{group.entries.map(entry => <li>{entry}</li>)}</ul>
          {sources.has(group.source) && <a href={sources.get(group.source)?.href}>{sources.get(group.source)?.label}</a>}
        </div>)}
      </div>
    </section>}
    <footer class="guide-end">
      <details>
        <summary>Fuentes y créditos</summary>
        <ul>
          {content.sources.map(source => <li><a href={source.href}>{source.label}</a></li>)}
          {showMap && <li><a href="https://www.naturalearthdata.com/downloads/110m-physical-vectors/">Mapa base de Natural Earth</a></li>}
        </ul>
        <p>Portada e imágenes de capítulo generadas para FraganUS.</p>
      </details>
      <a class="guide-text-link" href="/guias">Volver a Guías <ArrowRight size={17} aria-hidden="true" /></a>
    </footer>
  </article> : <section class="container inner-section">
    <h1 class="inner-title">Guía no encontrada</h1><a class="button secondary" href="/guias">Volver a Guías</a>
  </section>}
</Base>

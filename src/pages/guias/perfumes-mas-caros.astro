---
import { ArrowDown, ArrowUpRight } from '@lucide/astro';
import GuideImage from '../../components/GuideImage.astro';
import ChapterText from '../../components/guides/ChapterText.astro';

import GuideArticle from '../../components/guides/GuideArticle.astro';
import DrawOnScroll from '../../components/guides/DrawOnScroll.astro';
import { getGuideStory } from '../../lib/guides';
import { storeEnv } from '../../lib/runtime';

const { guide, next } = await getGuideStory(storeEnv.DB, 'perfumes-mas-caros');
const { chapters, sources } = guide?.content ?? { chapters: [], sources: [] };
const exhibits: Record<string, string> = {
  boutique: 'Precio de boutique',
  edicion: 'Precio de lanzamiento',
  paris: 'Precio sugerido y precio de remate',
  dubai: 'Valoración de marca',
  comparar: 'Comparación',
};
---
<GuideArticle {guide}>
  {guide && <>
    <header class="exhibit-cover">
      <GuideImage imageKey={guide.cover_key} alt={guide.cover_alt} sizes="(max-width: 760px) calc(100vw - 32px), 1280px" priority />
      <div class="exhibit-cover-copy">
        <h1>{guide.title}</h1>
        <p>{guide.description}</p>
        <a class="button secondary" href={`#${chapters[0].id}`}>Entrar a la vitrina <ArrowDown size={17} aria-hidden="true" /></a>
      </div>
    </header>
    <div class="exhibit-journey">
      <nav aria-label="Piezas de la vitrina">
        {chapters.map(chapter => <a href={`#${chapter.id}`}>{exhibits[chapter.id]}</a>)}
      </nav>
      <div class="exhibit-rooms">
        {chapters.map(chapter => <section class="guide-chapter exhibit-room" id={chapter.id} aria-labelledby={`titulo-${chapter.id}`} data-guide-draw>
          <div class="exhibit-label">
            <svg viewBox="0 0 72 60" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round">
              {chapter.id === 'boutique' && <><path d="M17 53h38M22 53V34a14 14 0 0 1 28 0v19M32 20v-6h8v6" /><path data-draw-line pathLength="1" d="M28 47h16v-9l-4-5h-8l-4 5zM33 33v-5h6v5" /></>}
              {chapter.id === 'edicion' && <><path d="M13 25h46v27H13zM13 25l10-12h26l10 12M36 25v27" /><path data-draw-line pathLength="1" d="M13 34h46M36 25l-9-8c-8-7 0-14 5-6l4 14 4-14c5-8 13-1 5 6z" /></>}
              {chapter.id === 'paris' && <><path d="M10 50h25m-21-5h17m7-18 11 11m-21-7 18-18 10 10-18 18z" /><path data-draw-line pathLength="1" d="m49 37 12 12-4 4-12-12M12 19h9m-4-4v8" /></>}
              {chapter.id === 'dubai' && <><path d="M14 28l8-12h28l8 12-22 25zM14 28h44" /><path data-draw-line pathLength="1" d="M22 16l6 12 8 25 8-25 6-12M28 28l8-12 8 12M36 4v5M59 10l-4 5M13 10l4 5" /></>}
              {chapter.id === 'comparar' && <><path d="M36 11v39m-13 0h26M14 20h44M14 20l-9 19h18zm44 0-9 19h18z" /><path data-draw-line pathLength="1" d="M5 39a9 5 0 0 0 18 0m26 0a9 5 0 0 0 18 0M32 16l4-5 4 5" /></>}
            </svg>
            <p>{exhibits[chapter.id]}</p>
            {chapter.place && <p>{chapter.place}</p>}
          </div>
          <div class="exhibit-text">
            <h2 id={`titulo-${chapter.id}`}>{chapter.heading}</h2>
            <ChapterText {chapter} {sources} />
          </div>
        </section>)}
      </div>
    </div>
    {next && <aside class="exhibit-next">
      <p>{next.description}</p>
      <a class="guide-text-link" href={`/guias/${next.card.slug}`}>{next.card.title} <ArrowUpRight size={18} aria-hidden="true" /></a>
    </aside>}

    <DrawOnScroll />
  </>}
</GuideArticle>

<style>
  .exhibit-cover {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: clamp(440px, 48vw, 680px);
    overflow: hidden;
    border-radius: 16px;
    color: #fff6ec;
    background: #221526;
  }
  .exhibit-cover::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(90deg, #201322 7%, #201322ed 29%, #21142378 60%, transparent 87%);
  }
  .exhibit-cover :global(img) { position: absolute; z-index: -2; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 65% 42%; }
  .exhibit-cover-copy { max-width: min(60%, 720px); padding: clamp(32px, 6vw, 90px); }
  .exhibit-cover h1 { font: 500 clamp(42px, 5.2vw, 76px)/1.04 var(--serif); letter-spacing: -.038em; text-wrap: balance; }
  .exhibit-cover p { margin-top: 17px; max-width: 44ch; color: #f0ded9; }
  .exhibit-cover .button { margin-top: 26px; color: #fff6ec; border-color: #b792ab; }
  .exhibit-cover .button:hover { color: var(--plum); background: #f6e5ed; }
  .exhibit-journey { margin-top: clamp(30px, 6vw, 82px); display: grid; grid-template-columns: minmax(170px,.32fr) minmax(0,1fr); gap: clamp(24px, 5vw, 78px); }
  .exhibit-journey nav { position: sticky; top: calc(var(--sticky-header-height) + 20px); align-self: start; display: grid; border-top: 1px solid #ded1db; }
  .exhibit-journey nav a { display: flex; min-height: 44px; align-items: center; padding: 8px 10px; border-bottom: 1px solid #ded1db; color: #5d3654; font-weight: 700; }
  .exhibit-journey nav a:hover { background: #f2e9ec; text-decoration: underline; }
  .exhibit-room { display: grid; grid-template-columns: minmax(110px,.24fr) minmax(0,1fr); gap: clamp(20px, 4vw, 58px); padding-top: 24px; }
  .exhibit-label { align-self: start; padding: 16px; background: #f1e6e9; color: #63384e; }
  .exhibit-label svg { width: min(100%, 78px); margin-bottom: 9px; }
  .exhibit-label p:first-of-type { font-weight: 750; }
  .exhibit-label p + p { margin-top: 4px; font-size: .84rem; }
  .exhibit-next { padding-block: 22px; border-block: 1px solid #e5d9eb; color: var(--muted); }
  @media (max-width: 900px) {
    .exhibit-journey { grid-template-columns: 1fr; gap: 30px; }
    .exhibit-journey nav { position: static; grid-template-columns: repeat(auto-fit,minmax(140px,1fr)); }
  }
  @media (max-width: 660px) {
    .exhibit-cover { min-height: 0; }
    .exhibit-cover :global(img) { position: static; width: 100%; height: auto; aspect-ratio: 3/2; object-position: center; }
    .exhibit-cover::after { display: none; }
    .exhibit-cover-copy { max-width: none; padding: 25px 20px 30px; }
    .exhibit-cover h1 { font-size: clamp(34px, 8.5vw, 53px); }
    .exhibit-room { grid-template-columns: 1fr; gap: 18px; }
    .exhibit-label { display: flex; width: fit-content; align-items: center; flex-wrap: wrap; gap: 4px 10px; padding: 6px 11px; }
    .exhibit-label svg { width: 35px; margin: 0; }
    .exhibit-label p + p { margin: 0; }
  }
</style>

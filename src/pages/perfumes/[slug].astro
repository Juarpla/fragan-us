---
import { ArrowRight, ChevronRight, ExternalLink, Heart, Layers, ShoppingBag, SprayCan } from '@lucide/astro';
import FragranceVisual from '../../components/FragranceVisual.astro';
import Base from '../../layouts/Base.astro';
import TikTok from '../../components/icons/TikTok.astro';
import ProductCard from '../../components/ProductCard.astro';
import { climateLabel, money, occasionLabel, productSpecs } from '../../lib/catalog';
import { catalogHref, catalogParams, catalogSelection } from '../../lib/catalog-filters';
import { getCatalog } from '../../lib/db';
import { storeEnv } from '../../lib/runtime';

const { filters, query, page } = catalogSelection(Astro.url.searchParams);
const backToCatalog = catalogHref(filters, query, page);
const products = await getCatalog(storeEnv);
const product = products.find(item => item.slug === Astro.params.slug);
if (!product) Astro.response.status = 404;
const reviewsHref = product && `https://www.tiktok.com/search?${new URLSearchParams({ q: `reseña ${product.brand} ${product.name}` })}`;
const notes = product ? [
  { label: 'Salida', Icon: SprayCan, notes: product.notes.opening, tone: 'sand' },
  { label: 'Corazón', Icon: Heart, notes: product.notes.heart, tone: 'rose' },
  { label: 'Fondo', Icon: Layers, notes: product.notes.base, tone: 'lilac' },
].filter(note => note.notes) : [];
const specs = product && productSpecs(product);
const related = products.filter(item => item.slug !== product?.slug).slice(0, 4);
---
<Base title={product ? `${product.name} de ${product.brand}` : 'Perfume no encontrado'} description={product?.description || undefined}>
  {product ? <div class="container detail-section">
    <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><ChevronRight size={14} /><a href={backToCatalog}>Perfumes</a><ChevronRight size={14} /><span aria-current="page">{product.name}</span></nav>
    <section class="detail-layout" aria-labelledby="product-title">
      <FragranceVisual product={product} />
      <div class="detail-info">
        <h1 id="product-title">{product.name}</h1>
        <p class="detail-identity">{[product.brand, product.audience].filter(Boolean).join(' · ')}</p>
        {specs && <p>{specs}</p>}
        <strong class="detail-price">{money(product.price_cents)}</strong>
        {product.description && <p>{product.description}</p>}
        <p class="detail-stock">{product.stock > 0 ? `${product.stock} ${product.stock === 1 ? 'unidad disponible' : 'unidades disponibles'}` : 'Agotado'}</p>
        <div class="detail-actions">
          <button class="button primary" type="button" data-add={JSON.stringify(product)} disabled={!product.stock}><ShoppingBag size={18} aria-hidden="true" /> Agregar a la bolsa</button>
          <a class="button secondary" href={reviewsHref} target="_blank" rel="noopener noreferrer"><TikTok size={17} /> Ver reseñas en TikTok <ExternalLink size={14} aria-hidden="true" /></a>
        </div>
        <div class="detail-tags">{[...product.climate, ...product.occasions].map(key => {
          const label = climateLabel[key] ?? occasionLabel[key];
          return label && <a href={catalogHref([key])}>{label}</a>;
        })}</div>
      </div>
    </section>
    {notes.length > 0 && <section class="note-section" aria-labelledby="notes-title">
      <h2 id="notes-title">Notas olfativas</h2>
      <dl class="note-grid">
        {notes.map(({ label, Icon, notes, tone }) => (
          <div class:list={['note-tier', tone]}>
            <dt><span class="note-icon"><Icon size={21} stroke-width={1.65} aria-hidden="true" /></span>{label}</dt>
            <dd>{notes}</dd>
          </div>
        ))}
      </dl>
    </section>}
  </div> : <section class="container inner-section"><h1 class="inner-title">Perfume no encontrado</h1><a class="button primary" href={backToCatalog}>Explorar perfumes <ArrowRight size={18} /></a></section>}
  {product && related.length > 0 && <section class="container detail-section"><div class="section-heading"><h2>También te puede gustar</h2></div><div class="product-grid">{related.map(item => <ProductCard product={item} catalogQuery={catalogParams(filters, query, page)} />)}</div></section>}
</Base>

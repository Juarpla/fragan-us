---
import { ArrowRight, ChevronRight, ExternalLink, Heart, Layers, Share2, ShoppingBag, SprayCan } from '@lucide/astro';
import FragranceVisual from '../../components/FragranceVisual.astro';
import Base from '../../layouts/Base.astro';
import TikTok from '../../components/icons/TikTok.astro';
import ProductCard from '../../components/ProductCard.astro';
import { climateLabel, money, occasionLabel, productSpecs } from '../../lib/catalog';
import { catalogHref, catalogParams, catalogSelection } from '../../lib/catalog-filters';
import { getCatalog } from '../../lib/db';
import { storeEnv } from '../../lib/runtime';

const { filters, query, page } = catalogSelection(Astro.url.searchParams);
const backToCatalog = catalogHref(filters, query, page);
const products = await getCatalog(storeEnv);
const product = products.find(item => item.slug === Astro.params.slug);
if (!product) Astro.response.status = 404;
const reviewsQuery = product && `reseña ${product.brand} ${product.name}`;
const reviewsHref = reviewsQuery && `https://www.tiktok.com/search?${new URLSearchParams({ q: reviewsQuery })}`;
const notes = product ? [
  { label: 'Salida', Icon: SprayCan, notes: product.notes.opening, tone: 'sand' },
  { label: 'Corazón', Icon: Heart, notes: product.notes.heart, tone: 'rose' },
  { label: 'Fondo', Icon: Layers, notes: product.notes.base, tone: 'lilac' },
].filter(note => note.notes) : [];
const specs = product && productSpecs(product);
const related = products.filter(item => item.slug !== product?.slug).slice(0, 4);
---
<Base title={product ? `${product.name} de ${product.brand}` : 'Perfume no encontrado'} description={product?.description || undefined}>
  {product ? <div class="container detail-section">
    <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><ChevronRight size={14} /><a href={backToCatalog}>Perfumes</a><ChevronRight size={14} /><span aria-current="page">{product.name}</span></nav>
    <section class="detail-layout" aria-labelledby="product-title">
      <FragranceVisual product={product} />
      <div class="detail-info">
        <div class="detail-heading">
          <h1 id="product-title">{product.name}</h1>
          <button class="button share-perfume" type="button" data-share-perfume={`${product.name} de ${product.brand} | FraganUS`} hidden>
            <Share2 size={17} aria-hidden="true" /> Compartir
          </button>
        </div>
        <div class="share-status" role="status" data-share-status></div>
        <input class="share-url" type="url" aria-label="Enlace del perfume" data-share-url readonly hidden />
        <p class="detail-identity">{[product.brand, product.audience].filter(Boolean).join(' · ')}</p>
        {specs && <p>{specs}</p>}
        <strong class="detail-price">{money(product.price_cents)}</strong>
        {product.description && <p>{product.description}</p>}
        <p class="detail-stock">{product.stock > 0 ? `${product.stock} ${product.stock === 1 ? 'unidad disponible' : 'unidades disponibles'}` : 'Agotado'}</p>
        <div class="detail-actions">
          <button class="button primary" type="button" data-add={JSON.stringify(product)} disabled={!product.stock}><ShoppingBag size={18} aria-hidden="true" /> Agregar a la bolsa</button>
          <a class="button secondary" href={reviewsHref} target="_blank" rel="noopener noreferrer" data-tiktok-search={reviewsQuery}><TikTok size={17} /> Ver reseñas en TikTok <ExternalLink size={14} aria-hidden="true" /></a>
        </div>
        <a class="reviews-web" href={reviewsHref} target="_blank" rel="noopener noreferrer" hidden>Abrir búsqueda en el navegador</a>
        <div class="detail-tags">{[...product.climate, ...product.occasions].map(key => {
          const label = climateLabel[key] ?? occasionLabel[key];
          return label && <a href={catalogHref([key])}>{label}</a>;
        })}</div>
      </div>
    </section>
    {notes.length > 0 && <section class="note-section" aria-labelledby="notes-title">
      <h2 id="notes-title">Notas olfativas</h2>
      <dl class="note-grid">
        {notes.map(({ label, Icon, notes, tone }) => (
          <div class:list={['note-tier', tone]}>
            <dt><span class="note-icon"><Icon size={21} stroke-width={1.65} aria-hidden="true" /></span>{label}</dt>
            <dd>{notes}</dd>
          </div>
        ))}
      </dl>
    </section>}
  </div> : <section class="container inner-section"><h1 class="inner-title">Perfume no encontrado</h1><a class="button primary" href={backToCatalog}>Explorar perfumes <ArrowRight size={18} /></a></section>}
  {product && related.length > 0 && <section class="container detail-section"><div class="section-heading"><h2>También te puede gustar</h2></div><div class="product-grid">{related.map(item => <ProductCard product={item} catalogQuery={catalogParams(filters, query, page)} />)}</div></section>}
</Base>

<script>
  import { copyValue } from '../../scripts/clipboard-value';

  const shareButton = document.querySelector<HTMLButtonElement>('[data-share-perfume]');
  const shareStatus = document.querySelector<HTMLElement>('[data-share-status]');
  const shareUrl = document.querySelector<HTMLInputElement>('[data-share-url]');

  if (shareButton && shareStatus && shareUrl) {
    const title = shareButton.dataset.sharePerfume;
    const url = new URL(location.pathname, location.origin).href;
    const shareData = { title, url };
    let sharing = false;

    shareButton.hidden = false;
    shareButton.addEventListener('click', async () => {
      if (sharing) return;
      sharing = true;
      try {
        if (typeof navigator.share === 'function' && navigator.canShare?.(shareData) !== false) {
          try {
            await navigator.share(shareData);
            return;
          } catch (error) {
            if (error instanceof DOMException && error.name === 'AbortError') return;
          }
        }

        await copyValue(url, shareStatus, shareUrl, 'Enlace copiado.');
      } finally {
        sharing = false;
      }
    });
  }

  const appLink = document.querySelector<HTMLAnchorElement>('[data-tiktok-search]');
  const webLink = document.querySelector<HTMLAnchorElement>('.reviews-web');
  const query = appLink?.dataset.tiktokSearch;
  const { userAgent, maxTouchPoints } = navigator;
  const isAndroid = /Android/i.test(userAgent);
  const isAppleMobile = /iPhone|iPad|iPod/i.test(userAgent)
    || (/Macintosh/i.test(userAgent) && maxTouchPoints > 1);

  if (appLink && webLink && query && (isAndroid || isAppleMobile)) {
    const searchRoute = `search?keyword=${encodeURIComponent(query)}`;
    appLink.href = isAndroid
      ? `intent://${searchRoute}#Intent;scheme=snssdk1233;package=com.zhiliaoapp.musically;S.browser_fallback_url=${encodeURIComponent(webLink.href)};end`
      : `snssdk1233://${searchRoute}`;
    appLink.removeAttribute('target');
    webLink.hidden = false;
  }
</script>

<style>
  .detail-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .detail-heading h1 { min-width: 0; overflow-wrap: anywhere; }

  .share-perfume {
    flex: none;
    padding-inline: 10px;
    color: var(--purple-deep);
    background: transparent;
  }

  .share-perfume:hover { background: #f0e8f8; }

  .share-status { color: var(--purple-deep); font-size: .8rem; }
  .share-url {
    width: 100%;
    min-height: 44px;
    margin-block: 4px 10px;
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: #fff;
    font: inherit;
  }

  .reviews-web {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--purple-deep);
    font-size: .8rem;
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: .2em;
  }

  .reviews-web:not([hidden]) + .detail-tags { margin-top: 8px; }
</style>
